# Environment Variables (for reference)
# Copy to .env.local and fill in your values

# Next.js
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3000

# Database (for Spring Boot migration later)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=erp_db
# DB_USER=postgres
# DB_PASSWORD=

# Redis (for caching)
# REDIS_URL=redis://localhost:6379

# File Storage (S3-compatible)
# S3_BUCKET=erp-files
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Email (for notifications)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@erp.local

# Auth (for Spring Boot migration later)
# JWT_SECRET=your-secret-key-here
# JWT_EXPIRY=7d

# Debug
# DEBUG=erp:*
